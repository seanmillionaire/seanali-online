{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.seanali.online"
        }
      ],
      "destination": "https://seanali.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/links",
      "destination": "/page-map.html"
    },
    {
      "source": "/links.html",
      "destination": "/page-map.html"
    },
    {
      "source": "/my-links",
      "destination": "/page-map.html"
    },
    {
      "source": "/my-links.html",
      "destination": "/page-map.html"
    },
    {
      "source": "/linktree",
      "destination": "/page-map.html"
    },
    {
      "source": "/linktree.html",
      "destination": "/page-map.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "games.seanali.online"
        }
      ],
      "destination": "/games"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "games.seanali.online"
        }
      ],
      "destination": "/games/:path*"
    }
  ]
}
