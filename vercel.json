{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/games",
      "destination": "https://games.seanali.online",
      "permanent": true
    },
    {
      "source": "/games/:path*",
      "destination": "https://games.seanali.online/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.seanali.online"
        }
      ],
      "destination": "https://seanali.online/$1",
      "permanent": true
    }
  ]
}
