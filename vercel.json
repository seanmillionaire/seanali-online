{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.seanali.online"
        }
      ],
      "destination": "https://seanali.online/$1",
      "permanent": true
    },
    {
      "source": "/blog/money/the-sean-ali-guide-to-money-identity",
      "destination": "/blog/money/what-panama-taught-me-about-reprogramming-subconscious-money-beliefs",
      "permanent": true
    },
    {
      "source": "/blog/money/the-sean-ali-guide-to-money-identity/",
      "destination": "/blog/money/what-panama-taught-me-about-reprogramming-subconscious-money-beliefs",
      "permanent": true
    },
    {
      "source": "/blog/money/how-to-reprogram-your-subconscious-money-beliefs",
      "destination": "/blog/money/what-panama-taught-me-about-reprogramming-subconscious-money-beliefs",
      "permanent": true
    },
    {
      "source": "/blog/money/how-to-reprogram-your-subconscious-money-beliefs/",
      "destination": "/blog/money/what-panama-taught-me-about-reprogramming-subconscious-money-beliefs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/links",
      "destination": "/page-map"
    },
    {
      "source": "/links.html",
      "destination": "/page-map"
    },
    {
      "source": "/my-links",
      "destination": "/page-map"
    },
    {
      "source": "/my-links.html",
      "destination": "/page-map"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "games.seanali.online"
        }
      ],
      "destination": "/games"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "games.seanali.online"
        }
      ],
      "destination": "/games/:path*"
    }
  ]
}
