{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin/master-plan",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin/master-plan/index.html",
      "destination": "/admin",
      "permanent": false
    },
    {
