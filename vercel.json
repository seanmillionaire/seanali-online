      "destination": "/page-map"
    },
    {
      "source": "/links.html",
      "destination": "/page-map"
    },
    {
      "source": "/my-links",
      "destination": "/page-map"
    },
    {
      "source": "/my-links.html",
      "destination": "/page-map"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "games.seanali.online"
        }
      ],
      "destination": "/games"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "games.seanali.online"
        }
      ],
      "destination": "/games/:path*"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'self' https://sean-ali-clip-factory.darkrain20.chatgpt.site https://angelique-panama-video-pack.darkrain20.chatgpt.site https://hypnotic-meditations-shorts-producer.darkrain20.chatgpt.site https://hm-audio-meditation-factory.darkrain20.chatgpt.site"
